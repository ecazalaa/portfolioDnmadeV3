---
import Base from '../../layouts/Base.astro';
import HeroSlides from '../../components/HeroSlides.astro';
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((p) => ({
    params: { slug: p.id },
    props: { project: p },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const { title, year, place, tools, cover, coverAlt, covers, gallery } = project.data;

const heroSlides = [
  { src: cover, alt: coverAlt || title },
  ...covers.map((c) => ({ src: c.src, alt: c.alt || title, caption: c.caption })),
];

// rotation légère et déterministe (pas de flash aléatoire au chargement)
const rotations = [-2.5, 1.8, 1, -2, 2.3, -1.4];
const sizeMax: Record<'s' | 'm' | 'l', number> = {
  s: 280,
  m: 440,
  l: 720,
};
---
<Base title={title} current="portfolio" description={`${title} — ${place ?? ''}`}>
  <section class="wrap head">
    <a class="back mono" href="/portfolio">← Portfolio</a>
    <h1>{title}</h1>
    <div class="pmeta">
      <div><span class="hand">année</span><b>{year}</b></div>
      {place && <div><span class="hand">lieu</span><b>{place}</b></div>}
      {tools && <div><span class="hand">outils</span><b>{tools}</b></div>}
    </div>
  </section>

  <div class="wrap">
    <HeroSlides slides={heroSlides} />
  </div>

  <section class="wrap ptext">
    <div class="mono">Intention</div>
    <div class="prose"><Content /></div>
  </section>

  {gallery.length > 0 && (
    <section class="wrap board-s">
      <div class="mono board-label">
        Cahier — <span class="hand">croquis, planches, réflexions</span>
      </div>
      <div class="board-grid">
        {gallery.map((g, i) => {
          const cap = sizeMax[g.size];
          const w = Math.min(g.src.width, cap);
          return (
            <figure
              class="tack"
              style={`--w: ${w}px; transform: rotate(${rotations[i % rotations.length]}deg);`}
            >
              <Image
                src={g.src}
                alt={g.alt || title}
                widths={[320, 640, 960, 1400]}
                sizes={`${w}px`}
              />
              {g.caption && <figcaption>{g.caption}</figcaption>}
            </figure>
          );
        })}
      </div>
    </section>
  )}
</Base>

<style>
  .head { padding: clamp(32px, 6vw, 64px) 0 clamp(16px, 3vw, 28px); }
  .back { text-decoration: none; display: inline-block; margin-bottom: 1.4em; }
  .back:hover { color: var(--accent); }
  h1 {
    font-weight: 200;
    font-size: clamp(1.9rem, 5.5vw, 3.4rem);
    letter-spacing: -0.03em;
    margin: 0 0 0.5em;
  }
  .pmeta {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
    gap: 1.4em;
    padding-bottom: 1.6em;
  }
  .pmeta div span { display: block; font-size: 1.2rem; margin-bottom: 0.15em; }
  .pmeta div b { font-weight: 400; font-size: 0.95rem; }

  .ptext { padding: clamp(28px, 5vw, 56px) 0; }
  .prose {
    max-width: 68ch;
    color: var(--fg-2);
  }
  .prose :global(p) { margin: 0 0 1.1em; }
  .prose :global(p:first-child) { color: var(--fg); font-size: 1.1rem; font-weight: 300; }

  .board-s { padding-bottom: clamp(56px, 9vw, 100px); }
  .board-label { margin-bottom: 2em; }
  .board-grid {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: flex-start;
    gap: 2.6em 2em;
    padding: 0.4em 0.2em 1em;
  }
  .tack {
    margin: 0;
    width: var(--w);
    max-width: 100%;
    background: var(--paper);
    padding: 8px 8px 26px;
    box-shadow: 0 10px 24px rgba(20, 20, 20, 0.14);
    transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.4s;
    cursor: default;
  }
  .tack:hover {
    transform: rotate(0deg) scale(1.03) !important;
    box-shadow: 0 18px 34px rgba(20, 20, 20, 0.2);
    z-index: 2;
    position: relative;
  }
  .tack :global(img) {
    width: 100%;
    height: auto;
    display: block;
    object-fit: contain;
  }
  .tack figcaption {
    font-family: var(--font-hand);
    font-size: 1rem;
    color: var(--fg-2);
    padding-top: 6px;
    text-align: center;
  }
  @media (max-width: 760px) {
    .tack { width: 100%; transform: none !important; }
  }
</style>
