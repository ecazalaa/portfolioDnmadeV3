---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Slide {
  src: ImageMetadata;
  alt: string;
  caption?: string;
}

interface Props {
  slides: Slide[];
}

const { slides } = Astro.props;
const multiple = slides.length > 1;
---
<section class="hero" aria-roledescription={multiple ? 'carousel' : undefined} aria-label="Images du projet">
  <div class="hero-track" data-hero-track>
    {slides.map((slide, i) => (
      <figure class="hero-slide" data-hero-slide>
        <Image
          src={slide.src}
          alt={slide.alt}
          widths={[720, 1100, 1600, 2200]}
          sizes="(max-width: 1180px) 92vw, 1180px"
        />
        {slide.caption && <figcaption class="hand">{slide.caption}</figcaption>}
        {multiple && (
          <span class="sr-only">Image {i + 1} sur {slides.length}</span>
        )}
      </figure>
    ))}
  </div>

  {multiple && (
    <div class="hero-ui">
      <button type="button" class="hero-btn prev" data-hero-prev aria-label="Image précédente">←</button>
      <div class="hero-dots" data-hero-dots>
        {slides.map((_, i) => (
          <button
            type="button"
            class:list={['dot', { on: i === 0 }]}
            aria-label={`Aller à l'image ${i + 1}`}
            data-hero-dot={i}
          />
        ))}
      </div>
      <button type="button" class="hero-btn next" data-hero-next aria-label="Image suivante">→</button>
    </div>
  )}
</section>

<style>
  .hero { position: relative; }
  .hero-track {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    align-items: center;
    background: var(--card);
    scrollbar-width: none;
  }
  .hero-track::-webkit-scrollbar { display: none; }
  .hero-slide {
    flex: 0 0 100%;
    scroll-snap-align: start;
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 0;
  }
  .hero-slide :global(img) {
    display: block;
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: min(82vh, 920px);
    object-fit: contain;
  }
  .hero-slide figcaption {
    font-size: 1.05rem;
    color: var(--fg-2);
    padding: 0.55em 0.4em 0.9em;
    text-align: center;
  }
  .hero-ui {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1em;
    padding: 0.7em 0 0;
  }
  .hero-btn {
    all: unset;
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    letter-spacing: 0.08em;
    color: var(--fg-2);
    padding: 0.35em 0.2em;
  }
  .hero-btn:hover, .hero-btn:focus-visible { color: var(--accent); }
  .hero-dots { display: flex; gap: 0.45em; }
  .dot {
    all: unset;
    width: 7px;
    height: 7px;
    border-radius: 99px;
    background: var(--line);
    cursor: pointer;
  }
  .dot.on { background: var(--accent); }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }
</style>

<script>
  const track = document.querySelector<HTMLElement>('[data-hero-track]');
  if (track) {
    const slides = [...track.querySelectorAll<HTMLElement>('[data-hero-slide]')];
    const dots = [...document.querySelectorAll<HTMLButtonElement>('[data-hero-dot]')];
    const prev = document.querySelector<HTMLButtonElement>('[data-hero-prev]');
    const next = document.querySelector<HTMLButtonElement>('[data-hero-next]');

    const indexFromScroll = () => {
      const w = track.clientWidth || 1;
      return Math.round(track.scrollLeft / w);
    };

    const go = (i: number) => {
      const n = slides.length;
      const idx = ((i % n) + n) % n;
      track.scrollTo({ left: idx * track.clientWidth, behavior: 'smooth' });
    };

    const paint = () => {
      const i = indexFromScroll();
      dots.forEach((d, k) => d.classList.toggle('on', k === i));
    };

    prev?.addEventListener('click', () => go(indexFromScroll() - 1));
    next?.addEventListener('click', () => go(indexFromScroll() + 1));
    dots.forEach((d) => {
      d.addEventListener('click', () => go(Number(d.dataset.heroDot)));
    });
    track.addEventListener('scroll', () => paint(), { passive: true });
    window.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') go(indexFromScroll() - 1);
      if (e.key === 'ArrowRight') go(indexFromScroll() + 1);
    });
  }
</script>
